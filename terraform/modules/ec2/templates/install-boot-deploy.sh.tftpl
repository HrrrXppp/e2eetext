#!/bin/bash
# SSM aws:runShellScript defaults to /bin/sh (dash on Ubuntu). Bashisms like
# [[ must not be used without this shebang — otherwise IMAGE_TAG is never
# written and start_now never runs, while enable still "succeeds".
set -euo pipefail

REPO_ROOT='${repo_root}'
REPO_URL='${repo_url}'
REPO_BRANCH='${repo_branch}'
UNIT_DST=/etc/systemd/system/e2eetext.service
DEPLOY_ENV_DIR=/etc/e2eetext
DEPLOY_ENV_FILE="$DEPLOY_ENV_DIR/deploy.env"
# Association parameter. SSM substitutes this before the shell runs.
IMAGE_TAG='{{ ImageTag }}'
START_NOW='${start_now}'

install_host_packages() {
  if [ -f /etc/os-release ]; then
    # shellcheck source=/dev/null
    . /etc/os-release
  fi
  case "$${ID:-}" in
    amzn)
      dnf install -y docker git awscli
      ;;
    ubuntu)
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y docker.io git awscli
      ;;
    *)
      echo "Unsupported OS for boot-deploy package install: $${ID:-unknown}" >&2
      exit 1
      ;;
  esac
  systemctl enable --now docker
  if ! docker compose version >/dev/null 2>&1; then
    mkdir -p /usr/local/lib/docker/cli-plugins
    arch=$(uname -m)
    curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$arch" \
      -o /usr/local/lib/docker/cli-plugins/docker-compose
    chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
  fi
  if id ec2-user >/dev/null 2>&1; then
    usermod -aG docker ec2-user || true
  fi
}

if ! command -v docker >/dev/null 2>&1 \
  || ! command -v git >/dev/null 2>&1 \
  || ! command -v aws >/dev/null 2>&1 \
  || ! docker compose version >/dev/null 2>&1; then
  install_host_packages
fi
systemctl enable --now docker

mkdir -p /var/lib/e2eetext
exec 9>/var/lib/e2eetext/bootstrap.lock
flock -w 600 9

if [ ! -d "$REPO_ROOT/.git" ]; then
  mkdir -p "$(dirname "$REPO_ROOT")"
  if [ -e "$REPO_ROOT" ]; then
    if [ -n "$(ls -A "$REPO_ROOT" 2>/dev/null || true)" ]; then
      echo "Refusing to clone into non-empty $REPO_ROOT (not a git checkout)." >&2
      exit 1
    fi
    rmdir "$REPO_ROOT"
  fi
  git clone --branch "$REPO_BRANCH" --depth 1 "$REPO_URL" "$REPO_ROOT"
fi

if [ ! -d "$REPO_ROOT/maintenance/ec2" ]; then
  echo "Repo root $REPO_ROOT has no maintenance/ec2 after clone." >&2
  exit 1
fi

# A checkout that has not been updated still lists a client service.
# That image is no longer published. Remove the container, then drop the
# service, before deploy.sh pulls. A later checkout has no client service.
COMPOSE="$REPO_ROOT/maintenance/ec2/docker-compose.yml"
ENV_DOT="$REPO_ROOT/maintenance/ec2/.env"
if [ -f "$COMPOSE" ] && [ -f "$ENV_DOT" ] && grep -q '^[[:space:]]*client:' "$COMPOSE"; then
  docker compose --env-file "$ENV_DOT" -f "$COMPOSE" rm -sf client || true
fi
if [ -f "$COMPOSE" ] && grep -q '^[[:space:]]*client:' "$COMPOSE"; then
  awk 'BEGIN{skip=0} /^[[:space:]]*client:/{skip=1} skip{next} {print}' "$COMPOSE" >"$COMPOSE.tmp"
  mv "$COMPOSE.tmp" "$COMPOSE"
fi

cat >"$UNIT_DST" <<EOF
[Unit]
Description=e2eetext: ECR login, pull images if needed, start compose
Documentation=https://github.com/HrrrXppp/e2eetext
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$REPO_ROOT
EnvironmentFile=-/etc/e2eetext/deploy.env
ExecStart=/bin/bash $REPO_ROOT/maintenance/ec2/deploy.sh
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
EOF

mkdir -p "$DEPLOY_ENV_DIR"
if [ -n "$IMAGE_TAG" ]; then
  printf 'IMAGE_TAG=%s\n' "$IMAGE_TAG" >"$DEPLOY_ENV_FILE"
  chmod 0644 "$DEPLOY_ENV_FILE"

  # Also pin maintenance/ec2/.env so older deploy.sh (shell IMAGE_TAG from
  # source .env beats --env-file) still pulls the IaC tag after reboot.
  ENV_DOT="$REPO_ROOT/maintenance/ec2/.env"
  if [ -f "$ENV_DOT" ]; then
    if grep -q '^IMAGE_TAG=' "$ENV_DOT"; then
      sed -i "s|^IMAGE_TAG=.*|IMAGE_TAG=$IMAGE_TAG|" "$ENV_DOT"
    else
      printf 'IMAGE_TAG=%s\n' "$IMAGE_TAG" >>"$ENV_DOT"
    fi
  fi
fi

systemctl daemon-reload
systemctl enable e2eetext.service

if [ "$START_NOW" = "true" ]; then
  systemctl restart e2eetext.service
  # deploy.sh on an older checkout does not pass --remove-orphans, so the
  # client container would keep running after its service was removed.
  if [ -f "$COMPOSE" ] && [ -f "$REPO_ROOT/maintenance/ec2/.env" ]; then
    docker compose \
      --env-file "$REPO_ROOT/maintenance/ec2/.env" \
      --env-file "$DEPLOY_ENV_FILE" \
      -f "$COMPOSE" up -d --remove-orphans
  fi
fi
