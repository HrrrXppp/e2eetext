#!/bin/bash
# SSM aws:runShellScript defaults to /bin/sh (dash on Ubuntu). Bashisms like
# [[ must not be used without this shebang — otherwise IMAGE_TAG is never
# written and start_now never runs, while enable still "succeeds".
set -euo pipefail

REPO_ROOT='${repo_root}'
REPO_URL='${repo_url}'
REPO_BRANCH='${repo_branch}'
UNIT_DST=/etc/systemd/system/e2eetext.service
DEPLOY_ENV_DIR=/etc/e2eetext
DEPLOY_ENV_FILE="$DEPLOY_ENV_DIR/deploy.env"
# Association parameters. SSM substitutes these before the shell runs.
# "none" means do not pull or recreate the client container.
IMAGE_TAG='{{ ImageTag }}'
CLIENT_IMAGE_TAG='{{ ClientImageTag }}'
START_NOW='${start_now}'
START_SCRIPT_B64='${start_script_b64}'

install_host_packages() {
  if [ -f /etc/os-release ]; then
    # shellcheck source=/dev/null
    . /etc/os-release
  fi
  case "$${ID:-}" in
    amzn)
      dnf install -y docker git awscli
      ;;
    ubuntu)
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y docker.io git awscli
      ;;
    *)
      echo "Unsupported OS for boot-deploy package install: $${ID:-unknown}" >&2
      exit 1
      ;;
  esac
  systemctl enable --now docker
  if ! docker compose version >/dev/null 2>&1; then
    mkdir -p /usr/local/lib/docker/cli-plugins
    arch=$(uname -m)
    curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$arch" \
      -o /usr/local/lib/docker/cli-plugins/docker-compose
    chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose
  fi
  if id ec2-user >/dev/null 2>&1; then
    usermod -aG docker ec2-user || true
  fi
}

if ! command -v docker >/dev/null 2>&1 \
  || ! command -v git >/dev/null 2>&1 \
  || ! command -v aws >/dev/null 2>&1 \
  || ! docker compose version >/dev/null 2>&1; then
  install_host_packages
fi
systemctl enable --now docker

mkdir -p /var/lib/e2eetext
exec 9>/var/lib/e2eetext/bootstrap.lock
flock -w 600 9

if [ ! -d "$REPO_ROOT/.git" ]; then
  mkdir -p "$(dirname "$REPO_ROOT")"
  if [ -e "$REPO_ROOT" ]; then
    if [ -n "$(ls -A "$REPO_ROOT" 2>/dev/null || true)" ]; then
      echo "Refusing to clone into non-empty $REPO_ROOT (not a git checkout)." >&2
      exit 1
    fi
    rmdir "$REPO_ROOT"
  fi
  git clone --branch "$REPO_BRANCH" --depth 1 "$REPO_URL" "$REPO_ROOT"
fi

if [ ! -d "$REPO_ROOT/maintenance/ec2" ]; then
  echo "Repo root $REPO_ROOT has no maintenance/ec2 after clone." >&2
  exit 1
fi

mkdir -p /usr/local/lib/e2eetext
printf '%s' "$START_SCRIPT_B64" | base64 -d >/usr/local/lib/e2eetext/start-containers.sh
chmod 0755 /usr/local/lib/e2eetext/start-containers.sh

cat >"$UNIT_DST" <<EOF
[Unit]
Description=e2eetext: ECR login, pull images if needed, start compose
Documentation=https://github.com/HrrrXppp/e2eetext
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$REPO_ROOT
EnvironmentFile=-/etc/e2eetext/deploy.env
ExecStart=/bin/bash /usr/local/lib/e2eetext/start-containers.sh
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
EOF

mkdir -p "$DEPLOY_ENV_DIR"
if [ -n "$IMAGE_TAG" ]; then
  {
    printf 'IMAGE_TAG=%s\n' "$IMAGE_TAG"
    if [ -n "$CLIENT_IMAGE_TAG" ] && [ "$CLIENT_IMAGE_TAG" != "none" ]; then
      printf 'CLIENT_IMAGE_TAG=%s\n' "$CLIENT_IMAGE_TAG"
    fi
  } >"$DEPLOY_ENV_FILE"
  chmod 0644 "$DEPLOY_ENV_FILE"
fi

systemctl daemon-reload
systemctl enable e2eetext.service

if [ "$START_NOW" = "true" ]; then
  systemctl restart e2eetext.service
fi
