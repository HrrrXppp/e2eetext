#!/bin/bash
set -euo pipefail
# First launch. The decoded script installs Docker, git, and the AWS CLI
# when they are missing, clones the repo when the checkout is missing, then
# installs the boot unit. Brownfield instances get the same script via SSM
# (user_data is ignore_changes'd after create).
echo '${script_b64}' | base64 -d | bash
