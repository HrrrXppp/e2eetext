# Copy to terraform.tfvars and fill in with the REAL identifiers of the
# already-live dev stack (confirmed to exist on #27) before running
# `terraform import` — see README.md's "Infrastructure as code (Terraform)"
# section for the exact import commands. Do not `terraform apply` before
# importing.

aws_region = "us-east-2"

# Leave vpc_id/subnet_ids unset to use the account's default VPC, unless
# the live dev stack was placed in a custom VPC — check with
# `aws ec2 describe-instances --instance-ids <dev-instance-id>` (its
# VpcId/SubnetId fields) before assuming the default.
# vpc_id     = "vpc-xxxxxxxx"
# subnet_ids = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"]

# Required — get the real values from the live instance:
#   aws ec2 describe-instances --instance-ids <dev-instance-id> \
#     --query 'Reservations[0].Instances[0].[ImageId,InstanceType,SubnetId]'
ami_id        = "ami-xxxxxxxxxxxxxxxxx"
instance_type = "t3.small"
# ec2_subnet_id = "subnet-xxxxxxxx"

# Required — the dev ALB's security group ID (pre-existing):
#   aws elbv2 describe-load-balancers --names e2eetext-dev \
#     --query 'LoadBalancers[0].SecurityGroups'
alb_security_group_id = "sg-xxxxxxxx"

# Required — request/locate an ACM cert for the dev domain in this region:
#   aws acm list-certificates --region us-east-2
acm_certificate_arn = "arn:aws:acm:us-east-2:<AWS_ACCOUNT_ID>:certificate/xxxxxxxx"

# Optional — only if the live security group/role/instance-profile names
# differ from this module's defaults (e2eetext-dev-ec2 / -ec2-role /
# -ec2-profile). Check with:
#   aws ec2 describe-instances --instance-ids <dev-instance-id> \
#     --query 'Reservations[0].Instances[0].[SecurityGroups,IamInstanceProfile]'
# ec2_security_group_name       = "<actual-sg-name>"
# ec2_iam_role_name             = "<actual-role-name>"
# ec2_iam_instance_profile_name = "<actual-instance-profile-name>"

# admin_ssh_cidr_blocks = ["203.0.113.0/32"]
# key_name              = "e2eetext-dev-key"
