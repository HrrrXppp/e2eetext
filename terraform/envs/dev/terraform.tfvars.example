# terraform/envs/dev needs NO terraform.tfvars to plan: every variable has
# a confirmed-live default (audited against AWS 2026-07-26 — see
# variables.tf) or is looked up from the live stack by name in main.tf
# (ALB security group + ACM cert ARN come off the live "dev-e2eetext" ALB;
# the instance's SGs resolve from their names). Copy this file to
# terraform.tfvars only to OVERRIDE something — e.g. if the live stack has
# drifted from the audited values, or to stand dev up fresh in an account
# where the live ALB doesn't exist (then the by-name lookups fail and the
# explicit IDs below become required).
#
# Before `terraform import`, do set ec2_subnet_id (see below). Do not
# `terraform apply` before importing — see README.md's import bootstrap.

# aws_region   = "us-east-2"
# name_prefix  = "e2eetext-dev"

# Confirmed live 2026-07-26 (already the defaults — override only on drift):
# ami_id        = "ami-0e5497a77ef21b5ac"
# instance_type = "t3.small"
# key_name      = "alpha-0.0.1"
# alb_name      = "dev-e2eetext"
# server_target_group_name = "dev-server"
# client_target_group_name = "client"
# alb_idle_timeout         = 60
# https_default_action     = "fixed-404"
# api_rule_priority        = 100
# api_path_patterns        = ["/api/*"]
# create_health_rule       = false
# ec2_security_group_names = ["launch-wizard-2", "ec2-rds-1"]
# create_ec2_iam_instance_profile = false

# REQUIRED before `terraform import` (not for plain plan): the live
# instance's actual subnet — module.network's subnet order isn't
# guaranteed, and a subnet mismatch on aws_instance forces a replace.
#   aws ec2 describe-instances \
#     --query 'Reservations[0].Instances[0].[ImageId,InstanceType,SubnetId]'
# ec2_subnet_id = "subnet-xxxxxxxx"

# Only needed if the live ALB doesn't exist (fresh account) — otherwise
# main.tf looks these up from the ALB named alb_name:
# alb_security_group_id = "sg-xxxxxxxx"
# acm_certificate_arn   = "arn:aws:acm:us-east-2:<AWS_ACCOUNT_ID>:certificate/xxxxxxxx"

# Optional:
# vpc_id                = "vpc-xxxxxxxx"
# subnet_ids            = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"]
# alb_subnet_ids        = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"]
# admin_ssh_cidr_blocks = ["203.0.113.0/32"]
# tags                  = { Environment = "dev", ManagedBy = "terraform" }

# --- RDS (Phase 3) ---
# UNLIKE the above, none of this was audited against AWS (Phase 3 was
# implemented with no AWS credentials available) — every value below is
# REQUIRED with no default. Audit the live dev RDS instance first:
#   aws rds describe-db-instances --query \
#     'DBInstances[].[DBInstanceIdentifier,EngineVersion,DBInstanceClass,AllocatedStorage,StorageType,StorageEncrypted,MultiAZ,BackupRetentionPeriod,PreferredBackupWindow,PreferredMaintenanceWindow,DBSubnetGroup.DBSubnetGroupName]'
#   aws rds describe-db-parameter-groups
#
# rds_identifier             = "e2eetext-dev"
# rds_engine_version         = "16.4"
# rds_instance_class         = "db.t3.micro"
# rds_allocated_storage      = 20
# rds_storage_type           = "gp2"
# rds_storage_encrypted      = true
# Live CreateDBInstance DBName is ForceNew. If `aws rds describe-db-instances`
# shows DBName as null, leave this unset / null — setting a name forces
# destroy/recreate of the instance. The app's PostgreSQL database (often
# created later) is rds_app_database_name instead — live-dev uses
# "dev_e2eetext".
# rds_db_name                = null
# rds_app_database_name      = "dev_e2eetext"
# rds_username               = "messenger"
# rds_subnet_ids             = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]  # REQUIRED — no fallback default (PR #32 review); commonly PRIVATE subnets, unlike the public ones Phase 2 confirmed for ALB/EC2
# rds_subnet_group_name      = "<live-subnet-group-name>"
#   If the live instance sits in the account's implicit default VPC subnet
#   group (name literally "default"), set BOTH of:
# rds_subnet_group_name      = "default"
# rds_create_subnet_group    = false   # AWS rejects creating a group named "default" ("Default" is not allowed as "name") — confirmed live for dev
# rds_multi_az               = false
# rds_backup_retention_period = 1
# rds_backup_window          = "03:00-04:00"
# rds_maintenance_window     = "sun:04:30-sun:05:30"
#
# Pre-existing security group(s) if the live instance uses hand-made ones
# (dev's EC2 instance does — "ec2-rds-1", per Phase 2's audit — the RDS
# side is likely the same or a paired group):
# rds_security_group_ids        = ["sg-xxxxxxxx"]
# rds_ingress_security_group_id = "sg-xxxxxxxx"   # REQUIRED if rds_security_group_ids is left empty (module creates its own SG) — a precondition now fails the plan otherwise, rather than silently creating an SG with zero ingress rules (PR #32 review)
#
# Never put the real master password here — pass it out-of-band:
#   TF_VAR_rds_password="$(aws secretsmanager get-secret-value --secret-id <name> --query SecretString --output text)" terraform plan
#
# If a parameter group with pg_cron already exists live (e.g. #20's manual
# steps were followed by hand before this module existed), reference it
# instead of creating a new one:
# rds_create_parameter_group = false
# rds_parameter_group_name   = "<live-parameter-group-name>"
#
# If the live parameter group already preloads libraries besides pg_cron,
# list the FULL set here (this module sets shared_preload_libraries
# verbatim, so a partial list would drop the others on apply):
# rds_shared_preload_libraries = ["pg_cron", "pg_stat_statements"]
#
# Optional storage/monitoring detail, useful for a zero-diff import when
# the live instance uses any of them (all default to AWS's own "not set"/
# disabled defaults — see terraform/modules/rds/variables.tf for the full
# set): rds_iops, rds_storage_throughput, rds_kms_key_id,
# rds_max_allocated_storage, rds_ca_cert_identifier,
# rds_monitoring_interval, rds_monitoring_role_arn,
# rds_performance_insights_enabled, rds_enabled_cloudwatch_logs_exports.
