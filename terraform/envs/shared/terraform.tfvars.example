# Copy to terraform.tfvars and adjust to match the resources already created
# manually in AWS (see README.md's "Infrastructure as code (Terraform)"
# section for the exact `terraform import` commands to run first).

aws_region = "us-east-1"

github_org  = "HrrrXppp"
github_repo = "e2eetext"

# Must match the IAM role + inline policy already created for
# build-images.yml's secrets.AWS_ROLE_ARN (live role has an inline policy,
# not a managed policy attachment).
github_actions_role_name           = "github-actions-ecr-role"
github_actions_inline_policy_name  = "github-actions-ecr-rolePolicy"

# Only needed if the live OIDC provider's thumbprint differs from the
# module's default (GitHub's current root CA). Check via `aws iam
# get-open-id-connect-provider` if the post-import `terraform plan` shows
# a diff on this field.
# oidc_thumbprint_list = ["<actual-thumbprint>"]
