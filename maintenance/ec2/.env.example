# External PostgreSQL (e.g. AWS RDS). Server runs migrations on startup.
DATABASE_URL=postgres://USER:PASSWORD@your-rds-host.region.rds.amazonaws.com:5432/messenger?sslmode=require

# AWS ECR images (same values as maintenance/ecr/.env).
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
IMAGE_TAG=latest

# Optional: publish this node's WebSocketConnections metric to CloudWatch (#37).
# Needs an instance profile with cloudwatch:PutMetricData for the namespace
# (terraform/modules/ec2 metrics_namespace). Leave unset to disable.
# METRICS_CLOUDWATCH_NAMESPACE=E2EEText/Messenger
# METRICS_ENVIRONMENT=dev
