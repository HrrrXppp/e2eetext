# GitHub token used for the `git` credential helper (HTTPS push) and the
# GitHub API `curl` calls dispatched agents make. Needs repo read/write +
# issues/PRs scopes.
GITHUB_TOKEN=

# Claude Code auth. Set one of these (OAuth token is the usual path for
# unattended/headless use; ANTHROPIC_API_KEY also works if that's what's
# available).
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Git commit author identity for this container's commits.
GIT_AUTHOR_EMAIL=
GIT_AUTHOR_NAME=Claude (automated)

# Seconds to sleep between ticket-processing cycles.
CYCLE_INTERVAL_SECONDS=300

# Claude Code --permission-mode for the dispatched `claude -p` run. Defaults
# to dontAsk, which relies on the committed .claude/settings.json allowlist.
# Set to bypassPermissions only as a deliberate, owner-chosen opt-in if that
# allowlist proves too narrow for some new ticket shape -- it disables the
# permission system entirely and should not be left on by default.
CLAUDE_PERMISSION_MODE=dontAsk
